<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>MoldExposure</defName>
    <label>mold exposure</label>
    <description>Respiratory complications caused by exposure to mold spores. Steadily worsens while one spends time in the yellow rooms without a gas mask or hazmat suit. While it is not fatal on its own, it can lower breathing.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>0.001</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <stages>
      <li>
        <label>mild</label>
        <partEfficiencyOffset>-0.02</partEfficiencyOffset>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.3</minSeverity>
        <painOffset>0.02</painOffset>
        <partEfficiencyOffset>-0.1</partEfficiencyOffset>
      </li>
      <li>
        <label>severe</label>
        <minSeverity>0.6</minSeverity>
        <painOffset>0.1</painOffset>
        <partEfficiencyOffset>-0.3</partEfficiencyOffset>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.085</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>
  </HediffDef>
  
</Defs>