  <ThingDef ParentName="BuildingBase">
    <defName>YellowRooms_CeilingLamp</defName>
    <label>ceiling lamp</label>
    <description>A humming yellow ceiling lamp. It needs no power and cannot be destroyed, but it can be broken with the right orders.</description>
