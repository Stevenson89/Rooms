  <ThingDef ParentName="BuildingBase">
    <defName>YellowRooms_Pit</defName>
    <label>pit</label>
    <description>A dark pit in the floor of the Yellow Rooms. Something may yet crawl out of it. It is too wide to cross. Drop your items into the pit for a chance to receive something of equal or greater value in return. But tread carefully; who knows what might happen if you disturb the pit.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/YellowRooms/YellowRooms_Pit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/YellowRooms/YellowRooms_Pit</uiIconPath>
    <size>(2,2)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    
    <fillPercent>0</fillPercent>
    <blockWind>false</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <blockLight>false</blockLight>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <fertility>0</fertility>
    <canOverlapZones>false</canOverlapZones>
    
    <tickerType>Rare</tickerType>
    <building>
      <isEdifice>true</isEdifice>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
    <comps>
      <li Class="arsiy.Rooms.Things.CompProperties_Pit" />
    </comps>
  </ThingDef>

  
  
  
