  <ThingDef ParentName="BuildingBase">
    <defName>YellowRooms_MushroomFarm</defName>
    <label>carpet mushroom farm</label>
    <description>A patch of yellow carpet cultivated to grow various mushrooms. Different mushrooms are unlocked by research. Only grows in darkness.</description>
    <thingClass>Building_PlantGrower</thingClass>
    <graphicData>
      <texPath>Things/Building/YellowRooms/YellowRooms_MushroomFarm</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/YellowRooms/YellowRooms_MushroomFarm</uiIconPath>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>LowPlant</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.10</fillPercent>
    <castEdgeShadows>false</castEdgeShadows>
    <designationCategory>Production</designationCategory>
    <researchPrerequisites>
      <li>YellowRooms_BasicMushroomFarming</li>
    </researchPrerequisites>
    <costList>
      <YellowRooms_CarpetMaterial>20</YellowRooms_CarpetMaterial>
    </costList>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>0.6</Flammability>
      <Beauty>1</Beauty>
    </statBases>
    <fertility>1.2</fertility>
    <building>
      <defaultPlantToGrow>YellowRooms_Plant_EdibleMushroom</defaultPlantToGrow>
      <sowTag>YellowRoomsCarpet</sowTag>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
    </building>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="RimWorld.CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

  
  
  
  
