  <ThingDef ParentName="BuildingBase">
    <defName>YellowRooms_Wall</defName>
    <label>yellow wall</label>
    <description>An indestructible wall of the Yellow Rooms.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    
    <graphicData>
      <texPath>Things/Building/YellowRooms/YellowWall_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Wall</li>
        <li>Rock</li>
      </linkFlags>
    </graphicData>
    <uiIconPath>Things/Building/YellowRooms/YellowWall</uiIconPath>
    <size>(1, 1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>1</fillPercent>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <blockLight>true</blockLight>
    <holdsRoof>true</holdsRoof>
    <neverOverlapFloors>true</neverOverlapFloors>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <fertility>0</fertility>
    <canOverlapZones>false</canOverlapZones>
    <building>
      <isEdifice>true</isEdifice>
      <isInert>true</isInert>
      <isWall>true</isWall>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps />
  </ThingDef>

  
  
  
  
  <ThingDef ParentName="BuildingBase">
    <defName>YellowRooms_PortalToRooms</defName>
    <label>portal to rooms</label>
    <description>A portal leading into the Yellow Rooms dimension. Each portal links to a different location within the endless yellow rooms. Requires a portal core to build.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/YellowRooms/YellowRooms_PortalToRooms</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,4)</drawSize>
      <drawRotated>false</drawRotated>
      <drawOffsetSouth>(0, 0, 1.0)</drawOffsetSouth>
      <drawOffsetNorth>(0, 0, 1.0)</drawOffsetNorth>
      <drawOffsetEast>(0, 0, 0.5)</drawOffsetEast>
      <drawOffsetWest>(0, 0, 0.5)</drawOffsetWest>
    </graphicData>
    <size>(3,2)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0.5</fillPercent>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <blockLight>false</blockLight>
    <constructEffect>ConstructMetal</constructEffect>
    <repairEffect>Repair</repairEffect>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <designationCategory>Misc</designationCategory>
    <researchPrerequisites>
      <li>YellowRooms_StationaryTeleporter</li>
    </researchPrerequisites>
    <costList>
      <Steel>80</Steel>
      <ComponentSpacer>2</ComponentSpacer>
      <YellowRooms_PortalCore>1</YellowRooms_PortalCore>
    </costList>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Beauty>5</Beauty>
    </statBases>
    <building>
      <canPlaceOverWall>true</canPlaceOverWall>
      <isEdifice>true</isEdifice>
    </building>
    <placeWorkers>
      <li>arsiy.Rooms.Things.PlaceWorker_YellowRoomsPortal</li>
    </placeWorkers>
    <comps>
      <li Class="arsiy.Rooms.Things.CompProperties_DoorToRooms" />
    </comps>
  </ThingDef>

  
  
  
  
  
  
  
