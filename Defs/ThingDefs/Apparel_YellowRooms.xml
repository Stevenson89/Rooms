<?xml version="1.0" encoding="utf-8"?>
<Defs>

  
  
  
  
  
  
  
  <ThingDef ParentName="ArmorMachineableBase">
    <defName>YellowRooms_HazmatSuit</defName>
    <label>hazmat suit</label>
    <description>A rubber hazmat suit. It offers excellent protection against heat and toxic environments. Because it is worn close to the skin, body armor can still be worn over it.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Pawn/YellowRooms/Apparel/YellowRooms_HazmatSuit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stuffCategories>
      <li>YellowRoomsRubber</li>
    </stuffCategories>
    <colorPerStuff>
      <li>
        <stuff>YellowRooms_Rubber</stuff>
        <color>(255,255,255)</color>
      </li>
    </colorPerStuff>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>8</weight>
          <only>(0.98,0.88,0.30)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.90,0.80,0.35)</only>
        </li>
        <li>
          <weight>6</weight>
          <only>(0.80,0.68,0.20)</only>
        </li>
        <li>
          <weight>4</weight>
          <min>(0.68,0.58,0.16)</min>
          <max>(0.78,0.66,0.22)</max>
        </li>
      </options>
    </colorGenerator>
    <costStuffCount>50</costStuffCount>
    <statBases>
      <WorkToMake>6000</WorkToMake>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>1.2</Mass>
      <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Heat>0.6</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <ToxicEnvironmentResistance>0.5</ToxicEnvironmentResistance>
    </equippedStatOffsets>
    <apparel>
      <wornGraphicPath>Things/Pawn/YellowRooms/Apparel/hazmatsuit/HazmatSuit</wornGraphicPath>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <layers>
        <li>OnSkin</li>
      </layers>
      <immuneToToxGasExposure>true</immuneToToxGasExposure>
    </apparel>
  </ThingDef>

  
  
  
  
  
  <ThingDef ParentName="ArmorHelmetMakeableBase">
    <defName>YellowRooms_HazmatHelmet</defName>
    <label>hazmat helmet</label>
    <description>A sealed rubber helmet with a filtered visor. It resists toxic gas and harsh heat, functioning much like a gas mask.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Pawn/YellowRooms/Apparel/YellowRooms_HazmatHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stuffCategories>
      <li>YellowRoomsRubber</li>
    </stuffCategories>
    <colorPerStuff>
      <li>
        <stuff>YellowRooms_Rubber</stuff>
        <color>(255,255,255)</color>
      </li>
    </colorPerStuff>
    <costStuffCount>30</costStuffCount>
    <statBases>
      <WorkToMake>4000</WorkToMake>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>0.8</Mass>
      <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
    </equippedStatOffsets>
    <apparel>
      <wornGraphicPath>Things/Pawn/YellowRooms/Apparel/YellowRooms_HazmatHelmet</wornGraphicPath>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <layers>
        <li>Overhead</li>
      </layers>
      <immuneToToxGasExposure>true</immuneToToxGasExposure>
    </apparel>
  </ThingDef>

</Defs>
